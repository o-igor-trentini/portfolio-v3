# Example environment variables. Copy to `.env.local` for local development:
#
#   cp .env.example .env.local
#
# All variables are NEXT_PUBLIC_* — they're read at build time and inlined into
# the static export. None are secrets. Leave a value blank to fall back to the
# default baked into site.config.ts.

# Canonical site URL (metadata, Open Graph, sitemap, canonical links).
# Defaults to the `url` in site.config.ts when unset.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (looks like "G-XXXXXXX").
# When unset, no analytics script is rendered at all — so dev/local/preview
# builds never send data. In production it's provided by the CI as a repository
# variable (see .github/workflows/deploy.yml). Analytics loads with Consent
# Mode v2 defaulted to `denied`; the cookie banner grants consent on accept.
NEXT_PUBLIC_GA_ID=
